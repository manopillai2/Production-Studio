# Copy this file to server/.env and fill in what you need. Keys stay on the server only.
PORT=5175

# Paid generation master switch. Nothing is ever sent to a paid provider while this is false.
ENABLE_PAID_GENERATION=false

# Claude API: lyrics & planning drafts (implemented)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Placeholders: keys are detected, but generation is not implemented yet in v0.1
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
KLING_API_KEY=
GOOGLE_API_KEY=

# Optional Local AI (self-hosted Hunyuan3D-2 api_server.py; needs an NVIDIA GPU with >= 6 GB VRAM)
# LOCAL_AI_URL=http://127.0.0.1:8081
# LOCAL_AI_TEXTURE=true      # only if api_server.py was started with --enable_tex (>= 16 GB VRAM)

# Optional: point at a specific FFmpeg build
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# Max Meshy jobs running at once (your Meshy plan's concurrency limit; Pro = 10)
MESHY_MAX_CONCURRENT=10
