node_modules/
client/dist/
server/.env
*.log

# storage/ IS committed (database + media), except secrets and temporary files.
storage/secrets.json
storage/tmp/
storage/*.sqlite-wal
storage/*.sqlite-shm

# Project working files that can be regenerated (synth song stems, per-word TTS clips)
docs/project-*/music/*.wav
docs/project-*/music/tts/*.wav
docs/project-*/music/tts/*.f32

# Over GitHub's 100 MB per-file limit (outdated round-3 preview)
storage/media/exports/episode-16/2026-11-27T14-49-38-1080p/*.mp4
storage/media/exports/episode-16/2026-11-27T16-18-00-1080p/*.mp4
storage/media/exports/episode-17/*/*.mp4

# Claude Code session lock files
**/.claude/scheduled_tasks.lock
